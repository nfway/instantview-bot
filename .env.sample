# =========================
# Required / 必填
# =========================

# Telegram Bot Token
# Telegram 机器人 Token
TBTKN=123456789:your_bot_token

# Telegram admin user ID
# Telegram 管理员用户 ID
TGADMIN=123456789

# Telegraph access token
# Telegraph 访问令牌
TGPHTOKEN_0=your_telegraph_access_token

# =========================
# Access Control / 访问控制
# =========================

# Comma-separated Telegram user IDs allowed to use the bot
# 允许使用 bot 的 Telegram 用户 ID，多个用英文逗号分隔
# Priority / 优先级: ALLOWED_USER_IDS > SINGLE_USER_ID > TGADMIN
ALLOWED_USER_IDS=123456789,234567890,345678901

# Legacy single-user mode fallback
# 兼容旧版的单用户变量；当 ALLOWED_USER_IDS 为空时才会使用
#SINGLE_USER_ID=123456789

# =========================
# Optional / 可选
# =========================

# Enable debug logs: 1 = on
# 开启调试日志：1 表示开启
#DEV=1

# Bot username without @
# Bot 用户名，不带 @
#BOT_USERNAME=your_bot_username

# Extra message shown to users when parsing fails
# 解析失败时附加给用户的提示文本
#HELP_MESSAGE=If it keeps failing, try a cleaner source link. / 如果持续失败，请换一个更干净的原始链接再试。

# Disable Puppeteer fallback parser: 1 = off
# 禁用 Puppeteer 兜底解析：1 表示禁用
#NO_PUPPET=1

# Disable parsing flow entirely: 1 = off
# 完全禁用解析流程：1 表示禁用
#NO_PARSE=1

# REST API base URL used by some parsing flows
# 某些解析流程会用到的 REST API 基础地址
#REST_API=https://example.com/

# Headless mode flag if your environment uses it
# 如果你的环境需要，可设置无头模式标记
#HDLSS=1

# Timeout for IV creation in seconds
# IV 生成超时时间，单位秒
#IV_MAKING_TIMEOUT=60

# Log group/chat IDs if needed
# 如有需要，可填写日志群组/会话 ID
#TGGROUP=-1001234567890
#TGGROUPBUGS=-1001234567890

# Optional channel message forwarding config
# 可选：频道消息转发配置
#IV_CHAN_ID=1234567890
#IV_CHAN_MID=100
#IV_CHAN_MID_2=101
